{
  "hooks": {
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_bash.py", "timeout": 10, "onFailure": "block"}]},
      {"matcher": "Read|Glob|Grep", "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_paths.py", "timeout": 10, "onFailure": "block"}]}
    ]
  }
}
